{
    "splitmix": {
        "prefix": "splitmix",
        "body": [
            "struct SplitMix64 {",
            "    static uint64_t splitmix64(uint64_t x) {",
            "        x += 0x9e3779b97f4a7c15ULL;",
            "        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;",
            "        x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;",
            "        return x ^ (x >> 31);",
            "    }",
            "    size_t operator()(uint64_t x) const {",
            "        static const uint64_t FIXED_RANDOM = std::chrono::steady_clock::now().time_since_epoch().count();",
            "        return splitmix64(x + FIXED_RANDOM);",
            "    }",
            "};"
        ],
        "description": "Hashing function using splitmix64"
    },
    "minheap": {
        "prefix": "minheap",
        "body": [
            "template<typename T>",
            "using MinHeap = std::priority_queue<T, std::vector<T>, std::greater<T>>;"
        ],
        "description": "Min-heap using priority_queue"
    },
    "DSU": {
        "prefix": "DSU",
        "body": [
            "struct DSU {",
            "    std::vector<int> par, sz;",
            "",
            "    DSU(int n): par(n), sz(n, 1) { iota(par.begin(), par.end(), 0); }",
            "",
            "    int root(int v) { return v == par[v] ? v : par[v] = root(par[v]); }",
            "",
            "    bool unite(int u, int v) {",
            "        u = root(u), v = root(v);",
            "        if (u == v) return false;",
            "        if (sz[u] < sz[v]) std::swap(u, v);",
            "        par[v] = u;",
            "        sz[u] += sz[v];",
            "        return true;",
            "    }",
            "};"
        ],
        "description": "Disjoint Set Union structure"
    },
    "SegTreeMin": {
        "prefix": "SegTreeMin",
        "body": [
            "struct SegTreeMin {",
            "    std::vector<int> tree",
            "",
            "    SegTreeMin(int n): tree((4*n)+1) {};",
            "",
            "    void build(int v, int tl, int tr, const std::vector<int>& a) {",
            "        if (tl == tr) tree[v] = a[tl];",
            "        else {",
            "            int tm = (tl + tr) >> 1;",
            "            build(v<<1, tl, tm);",
            "            build(v<<1|1, tm+1, tr);",
            "            tree[v] = std::min(tree[v<<1], tree[v<<1|1]);",
            "        }",
            "    }",
            "",
            "    int query(int v, int tl, int tr, int l, int r) {",
            "        if (l > r) return INT_MAX;",
            "        if (tl >= l && tr <= r) return tree[v];",
            "        int tm = (tl + tr) >> 1;",
            "        int lft = query(v<<1, tl, tm, l, std::min(r, tm)); // go left",
            "        int rht = query(v<<1|1, tm+1, tr, std::max(l, tm+1), r); // go right",
            "        return std::min(lft, rht);",
            "    }",
            "};"
        ],
        "description": "Segment tree for min queries"
    },
    "SparseTableMin": {
        "prefix": "SparseTableMin",
        "body": [
            "struct SparseTableMin {",
            "    int n;",
            "    std::vector<std::vector<int>> st;",
            "",
            "    inline int log2_floor(int i) {",
            "        return i ? 31 - __builtin_clz(i) : -1;",
            "    }",
            "",
            "    SparseTableMin(const std::vector<int>& a) {",
            "        n = (int)a.size();",
            "        st.assign(log2_floor(n) + 1, std::vector<int>(n));",
            "        for (int i = 0; i < n; i++)",
            "            st[0][i] = a[i];",
            "        for (int i = 1; i <= log2_floor(n); i++)",
            "            for (int j = 0; j + (1 << i) <= n; j++)",
            "                st[i][j] = std::min(st[i - 1][j], st[i - 1][j + (1 << (i - 1))]);",
            "    }",
            "",
            "    inline int query(int l, int r) {",
            "        if (l > r) return INT_MAX;",
            "        int i = log2_floor(r - l + 1);",
            "        return std::min(st[i][l], st[i][r - (1 << i) + 1]);",
            "    }",
            "};"
        ],
        "description": "Sparse table for O(1) range minimum queries"
    }
}
